# Include important documentation and metadata files
include README.md
include CHANGELOG.md
include LICENSE
include pyproject.toml

# Documentation is deliberately NOT shipped.
#
# `recursive-include docs *.md` used to be here. It put this network's
# operational docs on PyPI: a Render deployment guide for one specific host,
# and a directory naming a dozen private domains. None of that means anything
# to someone who pip-installs the package.
#
# The feature docs (NETWORKS.md, BULLETIN.md) are worth reading but are
# currently written around one network as their running example, so they would
# ship that network too. They stay in the repo and are linked from the README,
# which is the file PyPI actually renders.
#
# If they are ever rewritten with neutral examples, allowlist them here BY
# NAME. Never re-add a recursive include: the next doc someone writes about
# our own deployment would ship silently.

# Include all Python files
recursive-include dash_improve_my_llms *.py
recursive-include dash_improve_my_llms py.typed

# Exclude common files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.so
global-exclude .git*

# Exclude test and development files
recursive-exclude tests *
recursive-exclude .venv *
recursive-exclude .idea *
recursive-exclude .claude *
recursive-exclude htmlcov *
recursive-exclude dist *
recursive-exclude build *
